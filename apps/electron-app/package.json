{
  "name": "@pandy/electron-app",
  "productName": "Pandy",
  "version": "0.1.0",
  "private": true,
  "description": "Pandy — a cute wellness companion for your desktop.",
  "license": "MIT",
  "author": {
    "name": "Shravani Nikam",
    "email": "nikam.shr@northeastern.edu"
  },
  "homepage": "https://github.com/shravanibnikam/pandy#readme",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "build": "node esbuild.mjs --production",
    "dev": "node esbuild.mjs && electron .",
    "start": "electron .",
    "package": "pnpm build && electron-builder --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "package:linux": "pnpm build && electron-builder --linux --publish never",
    "clean": "rm -rf dist ../../release/electron"
  },
  "dependencies": {
    "@pandy/core": "workspace:*",
    "@pandy/mascot": "workspace:*",
    "@pandy/messages": "workspace:*",
    "@pandy/shared-types": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  }
}
